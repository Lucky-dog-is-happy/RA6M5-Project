build generate_sbd_RA6M5-Projct: phony CMakeFiles/generate_sbd_RA6M5-Projct RA6M5-Projct.sbd RA6M5-Projct.elf


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/lucky/RA6M5-Project/build/Debug && /usr/bin/ccmake -S/home/lucky/RA6M5-Project -B/home/lucky/RA6M5-Project/build/Debug
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/lucky/RA6M5-Project/build/Debug && /usr/bin/cmake --regenerate-during-build -S/home/lucky/RA6M5-Project -B/home/lucky/RA6M5-Project/build/Debug
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


#############################################
# Custom command for CMakeFiles/open_rasc_RA6M5-Projct

build CMakeFiles/open_rasc_RA6M5-Projct | ${cmake_ninja_workdir}CMakeFiles/open_rasc_RA6M5-Projct: CUSTOM_COMMAND
  COMMAND = cd /home/lucky/RA6M5-Project && sh -c "/opt/renesas/rasc/eclipse/rasc configuration.xml &"
  DESC = FSP Smart Configurator


#############################################
# Phony custom command for CMakeFiles/generate_content_RA6M5-Projct

build CMakeFiles/generate_content_RA6M5-Projct | ${cmake_ninja_workdir}CMakeFiles/generate_content_RA6M5-Projct: phony configuration.xml.stamp


#############################################
# Custom command for configuration.xml.stamp

build configuration.xml.stamp | ${cmake_ninja_workdir}configuration.xml.stamp: CUSTOM_COMMAND /home/lucky/RA6M5-Project/configuration.xml
  COMMAND = cd /home/lucky/RA6M5-Project/build/Debug && echo Running\ RASC\ for\ generating\ project\ RA6M5-Projct\ content\ since\ modification\ is\ detected\ in\ configuration.xml: && echo /opt/renesas/rasc/eclipse/rasc -nosplash --launcher.suppressErrors --generate --devicefamily ra --compiler GCC --toolchainversion 14.2.0 --buildconfiguration Debug /home/lucky/RA6M5-Project/configuration.xml && /opt/renesas/rasc/eclipse/rasc -nosplash --launcher.suppressErrors --generate --devicefamily ra --compiler GCC --toolchainversion 14.2.0 --buildconfiguration Debug /home/lucky/RA6M5-Project/configuration.xml 2> rasc_cmd_log.txt && /usr/bin/cmake -E touch configuration.xml.stamp
  DESC = RASC pre-build to generate project content for RA6M5-Projct
  restat = 1


#############################################
# Phony custom command for CMakeFiles/generate_sbd_RA6M5-Projct

build CMakeFiles/generate_sbd_RA6M5-Projct | ${cmake_ninja_workdir}CMakeFiles/generate_sbd_RA6M5-Projct: phony RA6M5-Projct.sbd RA6M5-Projct.elf || RA6M5-Projct.elf generate_content_RA6M5-Projct


#############################################
# Custom command for RA6M5-Projct.sbd

build RA6M5-Projct.sbd | ${cmake_ninja_workdir}RA6M5-Projct.sbd: CUSTOM_COMMAND || RA6M5-Projct.elf generate_content_RA6M5-Projct
  COMMAND = cd /home/lucky/RA6M5-Project/build/Debug && echo Running\ RASC\ post-build\ to\ generate\ Smart\ Bundle\ file\ for\ RA6M5-Projct: && echo /opt/renesas/rasc/eclipse/rasc -nosplash --launcher.suppressErrors --gensmartbundleandpartition --devicefamily ra --compiler GCC --toolchainversion 14.2.0 --buildconfiguration Debug /home/lucky/RA6M5-Project/configuration.xml /home/lucky/RA6M5-Project/build/Debug/RA6M5-Projct.elf && /opt/renesas/rasc/eclipse/rasc -nosplash --launcher.suppressErrors --gensmartbundleandpartition --devicefamily ra --compiler GCC --toolchainversion 14.2.0 --buildconfiguration Debug /home/lucky/RA6M5-Project/configuration.xml /home/lucky/RA6M5-Project/build/Debug/RA6M5-Projct.elf 2> rasc_cmd_log.txt
  DESC = Generating RA6M5-Projct.sbd
  restat = 1

